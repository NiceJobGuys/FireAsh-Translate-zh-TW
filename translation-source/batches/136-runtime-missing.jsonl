{"section": 103, "en": "\\bBill: You've come at the right time.", "script": "Grandeur Club", "line": 118}
{"section": 103, "en": "\\bBill: Can I count on you?", "script": "Grandeur Club", "line": 118}
{"section": 103, "en": "\\bBill: We'll keep in touch!", "script": "Grandeur Club", "line": 118}
{"section": 103, "en": "\\rLorelei: May I go with you?", "script": "Grandeur Club", "line": 119}
{"section": 103, "en": "\\rLorelei: They will be at my mercy when they're frozen solid.", "script": "Grandeur Club", "line": 119}
{"section": 103, "en": "\\rLorelei: Pardon.", "script": "Grandeur Club", "line": 119}
{"section": 103, "en": "\\bRyuki: Awww yeah! I'm all fired up!", "script": "Grandeur Club", "line": 120}
{"section": 103, "en": "\\bRyuki: You're a star, man!", "script": "Grandeur Club", "line": 120}
{"section": 103, "en": "\\bRyuki: Fine by me!", "script": "Grandeur Club", "line": 120}
{"section": 103, "en": "\\rAgatha: I'll show you how a real Trainer battles.", "script": "Grandeur Club", "line": 121}
{"section": 103, "en": "\\rAgatha: You have a good eye, child, asking me to come along.", "script": "Grandeur Club", "line": 121}
{"section": 103, "en": "\\bTrace: What d'you say? You wanna come with me?", "script": "Grandeur Club", "line": 122}
{"section": 103, "en": "\\bTrace: Th-thanks, pal! It'll be a big relief to have you!", "script": "Grandeur Club", "line": 122}
{"section": 103, "en": "\\bTrace: Right... Then I'll just be here...", "script": "Grandeur Club", "line": 122}
{"section": 103, "en": "\\bBlue: Just leave everything to me!", "script": "Grandeur Club", "line": 123}
{"section": 103, "en": "\\bBlue: Follow my lead and try to keep up.", "script": "Grandeur Club", "line": 123}
{"section": 103, "en": "\\bBlue: Smell ya later!", "script": "Grandeur Club", "line": 123}
{"section": 103, "en": "\\rLeaf: Nice to meet you!", "script": "Grandeur Club", "line": 124}
{"section": 103, "en": "\\rLeaf: This looks like a job for me!", "script": "Grandeur Club", "line": 124}
{"section": 103, "en": "\\rLeaf: See you around!", "script": "Grandeur Club", "line": 124}
{"section": 103, "en": "\\bRed: ...", "script": "Grandeur Club", "line": 125}
{"section": 103, "en": "\\bRed: Hm!", "script": "Grandeur Club", "line": 125}
{"section": 103, "en": "\\bRed: Mmh!", "script": "Grandeur Club", "line": 125}
{"section": 103, "en": "\\bOak: Are you in need of my expertise?", "script": "Grandeur Club", "line": 126}
{"section": 103, "en": "\\bOak: Take care!", "script": "Grandeur Club", "line": 126}
{"section": 103, "en": "\\bGiovanni: Underestimate a man like me and you'll be in a world of pain.", "script": "Grandeur Club", "line": 127}
{"section": 103, "en": "\\bGiovanni: It was only a matter of time.", "script": "Grandeur Club", "line": 127}
{"section": 103, "en": "\\bFalkner: Let's chase the clouds.", "script": "Grandeur Club", "line": 128}
{"section": 103, "en": "\\bFalkner: The wind is with us! There's no time to lose!", "script": "Grandeur Club", "line": 128}
{"section": 103, "en": "\\bFalkner: See you later.", "script": "Grandeur Club", "line": 128}
{"section": 103, "en": "\\bBugsy: Let me demonstrate what I've learned from my studies!", "script": "Grandeur Club", "line": 129}
{"section": 103, "en": "\\bBugsy: Bye!", "script": "Grandeur Club", "line": 129}
{"section": 103, "en": "\\rWhitney: You just can't help to be infatuated with me, huh?", "script": "Grandeur Club", "line": 130}
{"section": 103, "en": "\\rWhitney: Hey!", "script": "Grandeur Club", "line": 130}
{"section": 103, "en": "\\bMorty: I can see what others cannot.", "script": "Grandeur Club", "line": 131}
{"section": 103, "en": "\\bMorty: We're aiming for number one.", "script": "Grandeur Club", "line": 131}
{"section": 103, "en": "\\bMorty: Later!", "script": "Grandeur Club", "line": 131}
{"section": 103, "en": "\\bChuck: Kyah!", "script": "Grandeur Club", "line": 132}
{"section": 103, "en": "\\bChuck: You better be ready!", "script": "Grandeur Club", "line": 132}
{"section": 103, "en": "\\bChuck: Hoh!", "script": "Grandeur Club", "line": 132}
{"section": 103, "en": "\\rJasmine: Steel will hang on to the very end!", "script": "Grandeur Club", "line": 133}
{"section": 103, "en": "\\rJasmine: I'd love to join you!", "script": "Grandeur Club", "line": 133}
{"section": 103, "en": "\\rJasmine: See you!", "script": "Grandeur Club", "line": 133}
{"section": 103, "en": "\\bPryce: I do not lose easily.", "script": "Grandeur Club", "line": 134}
{"section": 103, "en": "\\bPryce: I will lend you my strength, young one.", "script": "Grandeur Club", "line": 134}
{"section": 103, "en": "\\bPryce: Farewell.", "script": "Grandeur Club", "line": 134}
{"section": 103, "en": "\\rClair: I will use my full power against any opponent.", "script": "Grandeur Club", "line": 135}
{"section": 103, "en": "\\rClair: Fine! I suppose I can help you out.", "script": "Grandeur Club", "line": 135}
{"section": 103, "en": "\\rClair: Well, I'll see you later.", "script": "Grandeur Club", "line": 135}
{"section": 103, "en": "\\bWill: Nothing stands a chance against my psychic powers.", "script": "Grandeur Club", "line": 136}
{"section": 103, "en": "\\bWill: My, oh marvelous.", "script": "Grandeur Club", "line": 136}
{"section": 103, "en": "\\bWill: See you!", "script": "Grandeur Club", "line": 136}
{"section": 103, "en": "\\bKoga: They shall feel the despair of poison!", "script": "Grandeur Club", "line": 137}
{"section": 103, "en": "\\bKoga: I would be honored to accompany you.", "script": "Grandeur Club", "line": 137}
{"section": 103, "en": "\\bKoga: Begone!", "script": "Grandeur Club", "line": 137}
{"section": 103, "en": "\\bBruno: Believe in our potential!", "script": "Grandeur Club", "line": 138}
{"section": 103, "en": "\\bBruno: Off you go.", "script": "Grandeur Club", "line": 138}
{"section": 103, "en": "\\rKaren: I'm really a force to be reckoned with!", "script": "Grandeur Club", "line": 139}
{"section": 103, "en": "\\rKaren: I suppose I'm satisfied.", "script": "Grandeur Club", "line": 139}
{"section": 103, "en": "\\rKaren: Till we meet again.", "script": "Grandeur Club", "line": 139}
{"section": 103, "en": "\\bLance: Something tells me the two of us are going to make a first-class team.", "script": "Grandeur Club", "line": 140}
{"section": 103, "en": "\\bLance: Allow me to lend you my strength, whenever you should need it.", "script": "Grandeur Club", "line": 140}
{"section": 103, "en": "\\bLance: Later.", "script": "Grandeur Club", "line": 140}
{"section": 103, "en": "\\rLyra: I'm not sure what the future holds, but we'll have fun no matter what!", "script": "Grandeur Club", "line": 141}
{"section": 103, "en": "\\rLyra: Time for an adventure!", "script": "Grandeur Club", "line": 141}
{"section": 103, "en": "\\rLyra: Bye-bye!", "script": "Grandeur Club", "line": 141}
{"section": 103, "en": "\\bSilver: Oh, it's you. Whatever...", "script": "Grandeur Club", "line": 142}
{"section": 103, "en": "\\bSilver: Let's see what you're made of.", "script": "Grandeur Club", "line": 142}
{"section": 103, "en": "\\bSilver: Yeah.", "script": "Grandeur Club", "line": 142}
{"section": 103, "en": "\\bElm: How's it going?", "script": "Grandeur Club", "line": 144}
{"section": 103, "en": "\\bElm: Oh?", "script": "Grandeur Club", "line": 144}
{"section": 103, "en": "\\rRoxanne: Let's strategize before a battle.", "script": "Grandeur Club", "line": 145}
{"section": 103, "en": "\\rRoxanne: I shall accompany you.", "script": "Grandeur Club", "line": 145}
{"section": 103, "en": "\\rRoxanne: Then excuse me, while I am planning my moves.", "script": "Grandeur Club", "line": 145}
{"section": 103, "en": "\\bBrawly: The next big wave! Nice to meet you!", "script": "Grandeur Club", "line": 146}
{"section": 103, "en": "\\bBrawly: I think this will be a good wave to ride!", "script": "Grandeur Club", "line": 146}
{"section": 103, "en": "\\bBrawly: Later.", "script": "Grandeur Club", "line": 146}
{"section": 103, "en": "\\bWattson: I'm looking forward to our electrifying battle!", "script": "Grandeur Club", "line": 147}
{"section": 103, "en": "\\bWattson: We'll make sparks fly out from them!", "script": "Grandeur Club", "line": 147}
{"section": 103, "en": "\\bWattson: Wahahahah!", "script": "Grandeur Club", "line": 147}
