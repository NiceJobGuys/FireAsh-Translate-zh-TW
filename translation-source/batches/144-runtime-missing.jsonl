{"section": 103, "en": "\\rI'm sorry, but you need at least 5000 Poké Dollars to initiate a wonder trade.", "script": "Wonder Trade", "line": 260}
{"section": 103, "en": "\\rGreat, let's begin!", "script": "Wonder Trade", "line": 264}
{"section": 103, "en": "\\rSorry, those fossils are outside of my expertise.", "script": "QoL Functions", "line": 27}
{"section": 103, "en": "\\rI can't revive a Pokémon using duplicate fossils.", "script": "QoL Functions", "line": 29}
{"section": 103, "en": "\\rI can't revive a Pokémon using two head fossils.", "script": "QoL Functions", "line": 31}
{"section": 103, "en": "\\rI can't revive a Pokémon using two body fossils.", "script": "QoL Functions", "line": 33}
