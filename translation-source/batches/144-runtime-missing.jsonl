{"section": 103, "en": "\\bCheren: We'll show you what we've learnt.", "script": "Grandeur Club", "line": 494}
{"section": 103, "en": "\\bBianca: Time to take the next steps to glory!", "script": "Grandeur Club", "line": 495}
{"section": 103, "en": "\\rMay: Let's ride this wave!", "script": "Grandeur Club", "line": 496}
{"section": 103, "en": "\\bBrendan: Let's get heated up!", "script": "Grandeur Club", "line": 497}
{"section": 103, "en": "\\rSerena: I'm going to be strong enough to beat my best rival.", "script": "Grandeur Club", "line": 498}
{"section": 103, "en": "\\bCalem: Want to see what we can do at the beginning of our new journey?", "script": "Grandeur Club", "line": 499}
{"section": 103, "en": "\\bNate: Let's have a battle that'll touch everyone's hearts.", "script": "Grandeur Club", "line": 500}
{"section": 103, "en": "\\rRosa: Let's make a beautiful melody!", "script": "Grandeur Club", "line": 501}
{"section": 103, "en": "\\rLeaf: My love for my Pokémon gives me strength!", "script": "Grandeur Club", "line": 503}
{"section": 103, "en": "\\bBlue: Alright guys, follow me and try to keep up!", "script": "Grandeur Club", "line": 504}
{"section": 103, "en": "\\rMarnie: Wanna battle? I bet'cha do.", "script": "Grandeur Club", "line": 505}
{"section": 103, "en": "\\bHop: I'll show you what makes a Champion Professor strong!", "script": "Grandeur Club", "line": 506}
{"section": 103, "en": "\\bBede: Hmph! You're no match for us.", "script": "Grandeur Club", "line": 507}
{"section": 103, "en": "\\bElio: We're brighter than the sun!", "script": "Grandeur Club", "line": 508}
{"section": 103, "en": "\\rSelene: We're shining brighter than the moon!", "script": "Grandeur Club", "line": 509}
{"section": 103, "en": "\\bLuc-ker: You won't last in the presense of our aura!", "script": "Grandeur Club", "line": 510}
{"section": 103, "en": "\\bLance: We accept your challenge.", "script": "Grandeur Club", "line": 624}
{"section": 103, "en": "\\bSteven: We're truly the strongest there are now!", "script": "Grandeur Club", "line": 625}
{"section": 103, "en": "\\bN: Time for you to face our fully realised ideals.", "script": "Grandeur Club", "line": 627}
{"section": 103, "en": "\\bAlder: We'll prove we have no limits.", "script": "Grandeur Club", "line": 628}
{"section": 103, "en": "\\bSilver: To prove that our hearts are stronger than before, we'll crush you.", "script": "Grandeur Club", "line": 629}
{"section": 103, "en": "\\bEthan: We're soaring high!", "script": "Grandeur Club", "line": 630}
{"section": 103, "en": "\\bBlue: Try to keep up with our mach 2 speed!", "script": "Grandeur Club", "line": 631}
{"section": 103, "en": "\\bBrock: You won't break our rock-solid bonds!", "script": "Grandeur Club", "line": 632}
{"section": 103, "en": "\\rMisty: Ready to face my policy for battle?", "script": "Grandeur Club", "line": 633}
