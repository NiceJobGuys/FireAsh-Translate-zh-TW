+class PokemonRegionMap_Scene
+  # Red "!" marker on the next main-quest location (繁中 mode, not the editor);
+  # shown only when that location is on the region being displayed.
+  alias fire_ash_quest_pbStartScene pbStartScene
+  def pbStartScene(aseditor = false, mode = 0)
+    ret = fire_ash_quest_pbStartScene(aseditor, mode)
+    return ret if !ret || aseditor || !defined?(FireAshZHTW) || !FireAshZHTW.active?
+    pt = FireAshMainQuest.town_map_point
+    return ret if !pt || !@mapdata[pt[0]].equal?(@map)
+    marker = BitmapSprite.new(SQUAREWIDTH * 2, SQUAREHEIGHT * 2, @viewport)
+    FireAshMoveHints.draw(marker.bitmap, :quest, 10, 10)
+    marker.x = -SQUAREWIDTH / 2 + pt[1] * SQUAREWIDTH + (Graphics.width - @sprites["map"].bitmap.width) / 2
+    marker.y = -SQUAREHEIGHT / 2 + pt[2] * SQUAREHEIGHT + (Graphics.height - @sprites["map"].bitmap.height) / 2
+    marker.z = 1   # above the player icon; the cursor still shows on top when it passes over
+    @sprites["fire_ash_quest"] = marker
+    @sprites["cursor"].z = 2 if @sprites["cursor"]
+    ret
+  end
+end
