+# Chinese mode: the move lists show the highlighted move's type, category, power, accuracy, PP
+# and description in a panel on the right half. pbChooseList sorts `commands` in place, so the
+# list index maps straight to commands[index][2].
+module FireAshMoveInfo
+  CATEGORY = ["物理", "特殊", "變化"]
+
+  def self.text(id)
+    m = GameData::Move.get(id)
+    power = { 0 => "—", 1 => "?" }.fetch(m.base_damage, m.base_damage.to_s)
+    accuracy = (m.accuracy == 0) ? "—" : m.accuracy.to_s
+    "#{m.name}\n#{GameData::Type.get(m.type).name}・#{CATEGORY[m.category]}\n" \
+      "威力 #{power}　命中 #{accuracy}\nPP #{m.total_pp}\n#{m.description}"
+  end
+
+  def self.choose(commands, default)
+    return pbChooseList(commands, default, nil, -1) unless FireAshZHTW.active?
+    @commands = commands
+    @shown = nil
+    @panel = Window_AdvancedTextPokemon.newWithSize("", Graphics.width / 2, 0, Graphics.width / 2, Graphics.height)
+    @panel.z = 100000
+    pbChooseList(commands, default, nil, -1)
+  ensure
+    @panel.dispose if @panel
+    @panel = @commands = nil
+  end
+
+  def self.follow(window)
+    window.extend(Follow) if @panel
+  end
+
+  def self.show(index)
+    row = @panel && @commands[index]
+    return if !row || row[2] == @shown
+    @shown = row[2]
+    @panel.text = text(row[2])
+  end
+
+  module Follow
+    def update
+      super
+      FireAshMoveInfo.show(index)
+    end
+  end
+end
