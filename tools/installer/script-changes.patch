+# Speed affects accuracy (user request, 2026-11-02): base accuracy += (user speed - target speed)
+# x 0.25, so 70 becomes 82.5 when 50 faster and 57.5 when 50 slower. Never-miss (0) stays 0, and
+# the result is floored at 1 because 0 means "can't miss" to pbAccuracyCheck. OHKO moves use their
+# own level formula and are untouched. Prepended: nothing aliases or redefines this method later.
+module FireAshSpeedAccuracy
+  def self.adjust(base, user, target)
+    return base if base == 0
+    [base + (user.pbSpeed - target.pbSpeed) * 0.25, 1].max
+  end
+
+  # Fight menu panel: the move's base accuracy (weather etc. via pbBaseAccuracy) after the speed
+  # bonus against each opponent; a range when doubles foes differ. Stages, abilities and items are
+  # left out like the game's own accuracy figure. OHKO moves keep their printed value.
+  def self.text(user, move)
+    return FireAshMoveHints.dash_or(move.accuracy) if !user || move.accuracy == 0 || move.is_a?(PokeBattle_Move_070)
+    values = []
+    user.eachOpposing do |foe|
+      always = foe.effects[PBEffects::Telekinesis] > 0 || (foe.effects[PBEffects::Minimize] && move.tramplesMinimize?(1))
+      values << (always ? 0 : adjust(move.pbBaseAccuracy(user, foe), user, foe))
+    end
+    return FireAshMoveHints.dash_or(move.accuracy) if values.empty?
+    # Display only: capped at 100, and a doubles range drops decimals so it fits the 6-character slot.
+    shown = values.map { |v| v == 0 ? Float::INFINITY : [v, 100].min }.minmax.uniq   # can't miss sorts last
+    return "—" if shown == [Float::INFINITY]
+    return (shown[0] == shown[0].to_i ? shown[0].to_i.to_s : shown[0].to_s) if shown.length == 1
+    shown.map { |v| v.infinite? ? "—" : v.floor.to_s }.join("~")
+  rescue StandardError
+    FireAshMoveHints.dash_or(move.accuracy)
+  end
+
+  def pbCalcAccuracyModifiers(user, target, modifiers)
+    super
+    modifiers[:base_accuracy] = FireAshSpeedAccuracy.adjust(modifiers[:base_accuracy], user, target)
+  end
+end
+PokeBattle_Move.prepend(FireAshSpeedAccuracy)
