+class PokemonPauseMenu_Scene
+  # The menu command numbers are positional, so the entry is spliced in here
+  # and the caller only ever sees its own indexes.
+  alias fire_ash_quest_pbShowCommands pbShowCommands
+  def pbShowCommands(commands)
+    return fire_ash_quest_pbShowCommands(commands) if !$Trainer || !defined?(FireAshZHTW) || !FireAshZHTW.active?
+    at = (commands.index($Trainer.name) || commands.length - 1) + 1
+    list = commands.dup.insert(at, "主線任務")
+    loop do
+      ret = fire_ash_quest_pbShowCommands(list)
+      return (ret > at) ? ret - 1 : ret if ret != at
+      pbHideMenu
+      pbMessage(FireAshMainQuest.message)
+      pbShowMenu
+    end
+  end
+end
