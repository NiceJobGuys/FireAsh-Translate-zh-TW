+#===============================================================================
+# FireAsh field hints (appended by fire-ash-field-hints; display only)
+# Sparkles on unclaimed hidden items and a "!" bubble over NPCs that still hold
+# an item for the player. Alias-chained like the game's own hooks, never
+# prepended: Sprite_DynamicShadows and ParticleEngine alias these methods too,
+# and an alias taken after a prepend recurses forever.
+#===============================================================================
+module FireAshFieldHints
+  GIVE = /\bpbReceiveItem\s*\(/
+  # Overworld Pokémon that join the party when talked to ("Would you like to take X with you?").
+  JOIN = /\bpb(?:AddPokemon|AddPokemonSilent|AddToParty|AddToPartySilent|AddForeignPokemon)\s*\(/
+
+  # Pokémon overworld graphics are named after the species ("CATERPIE", "FARFETCHD_1") or "Pokemon NN".
+  def self.pokemon_graphic?(name)
+    return true if name[/\APokemon \d/]
+    GameData::Species.exists?(name.sub(/_\d+\z/, "").to_sym)
+  rescue StandardError
+    false
+  end
+  SPARKLE_INTERVAL = 120   # frames between sparkle bursts
+  # Frame 6 of the trainer "Exclaim bubble" animation, drawn without its sound.
+  BUBBLE_FILE   = "Graphics/Animations/029-Emotion01"
+  BUBBLE_RECT   = [7 % 5 * 192, 7 / 5 * 192, 192, 192]
+  BUBBLE_OFFSET = [8, 1 - 24]
+
+  def self.bubble_bitmap
+    @bubble = AnimatedBitmap.new(BUBBLE_FILE) if !@bubble || @bubble.bitmap.disposed?
+    @bubble.bitmap
+  end
+
+  BAG_CHECK = /\A\s*\$PokemonBag\.pbQuantity\((?:PBItems::|:)(\w+)\)\s*(<=|>=|==|<|>)\s*(\d+)\s*\z/
+
+  # nil means the branch depends on a script that cannot be run safely; it is treated as reachable.
+  def self.branch_true?(params, map_id, event_id)
+    case params[0]
+    when 0 then !!$game_switches[params[1]] == (params[2] == 0)
+    when 1
+      value = $game_variables[params[1]]
+      other = (params[2] == 0) ? params[3] : $game_variables[params[3]]
+      [:==, :>=, :<=, :>, :<, :!=][params[4]].then { |op| op && value.send(op, other) }
+    when 2 then ($game_self_switches[[map_id, event_id, params[1]]] == true) == (params[2] == 0)
+    when 12   # bag quantity is a pure read; other scripts may have side effects
+      $PokemonBag.pbQuantity($1.to_sym).send($2, $3.to_i) if params[1].is_a?(String) && params[1] =~ BAG_CHECK
+    end
+  rescue StandardError
+    nil
+  end
+
+  def self.gives_item?(list, map_id, event_id, pattern = GIVE)
+    blocked = []
+    conds = {}
+    list.each do |cmd|
+      depth = cmd.indent
+      blocked = blocked[0, depth]
+      script = case cmd.code
+               when 355, 655 then cmd.parameters[0]
+               when 111 then cmd.parameters[1] if cmd.parameters[0] == 12
+               end
+      return true if !blocked.any? && script.is_a?(String) && script[pattern]
+      if cmd.code == 111
+        conds[depth] = branch_true?(cmd.parameters, map_id, event_id)
+        blocked[depth] = (conds[depth] == false)
+      elsif cmd.code == 411   # Else
+        blocked[depth] = (conds[depth] == true)
+      end
+    end
+    false
+  end
+
+  # :sparkle, :bubble or nil for the event's active page.
+  def self.hint(name, page, map_id, event_id)
+    return nil if !page || page.list.length <= 1
+    graphic = page.graphic.character_name != "" || page.graphic.tile_id > 0
+    return (graphic ? nil : :sparkle) if name[/hiddenitem/i]
+    return nil unless graphic && page.trigger <= 2
+    # Some item balls ("Object ball", "Object ball special") call pbReceiveItem instead of pbItemBall; not NPCs.
+    return nil if page.graphic.character_name[/\AObject ball/i]
+    return :bubble if gives_item?(page.list, map_id, event_id)
+    return :bubble if pokemon_graphic?(page.graphic.character_name) && gives_item?(page.list, map_id, event_id, JOIN)
+    nil
+  end
+end
