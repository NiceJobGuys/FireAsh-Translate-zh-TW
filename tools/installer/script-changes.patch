+class Sprite_Character
+  alias fire_ash_hints_update update
+  def update
+    fire_ash_hints_update
+    show = @character.respond_to?(:fire_ash_hint) && @character.fire_ash_hint == :bubble &&
+           @character.should_update? && self.visible && !$game_system.map_interpreter.running?
+    if !show
+      @fire_ash_bubble.visible = false if @fire_ash_bubble
+      return
+    end
+    if !@fire_ash_bubble
+      @fire_ash_bubble = Sprite.new(self.viewport)
+      @fire_ash_bubble.bitmap = FireAshFieldHints.bubble_bitmap
+      @fire_ash_bubble.src_rect.set(*FireAshFieldHints::BUBBLE_RECT)
+      @fire_ash_bubble.ox = @fire_ash_bubble.oy = 96
+    end
+    @fire_ash_bubble.visible = true
+    @fire_ash_bubble.x = self.x + FireAshFieldHints::BUBBLE_OFFSET[0]
+    # BUBBLE_OFFSET fits a person whose art is 42px tall; Pokémon art is 32..64px, so follow its top.
+    @fire_ash_head ||= fire_ash_head_height
+    @fire_ash_bubble.y = self.y + FireAshFieldHints::BUBBLE_OFFSET[1] - (@fire_ash_head - 42)
+    @fire_ash_bubble.z = self.y + FireAshFieldHints::BUBBLE_OFFSET[1] + 32 + 32 + 17   # same as the animation's height 2
+    @fire_ash_bubble.tone = self.tone
+  end
+
+  # Height of the visible art in the current frame, measured once per sprite.
+  def fire_ash_head_height
+    b = self.bitmap
+    r = self.src_rect
+    return 42 if !b || b.disposed?
+    r.height.times do |y|
+      return r.height - y if (0...r.width).any? { |x| b.get_pixel(r.x + x, r.y + y).alpha > 0 }
+    end
+    42
+  rescue StandardError
+    42
+  end
+
+  alias fire_ash_hints_dispose dispose
+  def dispose
+    @fire_ash_bubble.dispose if @fire_ash_bubble
+    @fire_ash_bubble = nil
+    fire_ash_hints_dispose
+  end
+end
