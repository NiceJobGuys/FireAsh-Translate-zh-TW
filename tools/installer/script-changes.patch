+def pbForgetMove(pkmn,moveToLearn)
+  ret = -1
+  pbFadeOutIn {
+    scene = PokemonSummary_Scene.new
+    screen = PokemonSummaryScreen.new(scene)
+    ret = screen.pbStartForgetScreen([pkmn],0,moveToLearn)
+  }
+  return ret
+end
