+#===============================================================================
+# Level curve: from the Orange Islands on, wild and trainer Pokémon levels are
+# remapped per story region (FireAshMainQuest) so they keep rising from where
+# Kanto ends to Champion Leon at 90. Kanto is untouched. Old regions follow the
+# current story region. Levels are never lowered. Wild Pokémon evolve to match
+# their new level; trainer teams keep their species and listed moves.
+#===============================================================================
+module FireAshLevelCurve
+  # region => [original story min, original story max (league finale), new min, new max]
+  CURVE = {
+    orange: [15, 60, 50, 60], johto: [2, 61, 60, 65], hoenn: [3, 54, 65, 69],
+    frontier: [36, 65, 69, 72], sinnoh: [2, 60, 72, 76], unova: [2, 49, 76, 79],
+    kalos: [3, 60, 79, 82], alola: [2, 57, 82, 85], galar: [5, 80, 85, 90]
+  }
+
+  def self.region
+    q = FireAshMainQuest
+    s = q.next_step
+    i = s ? q::STEPS.index(s) : q::STEPS.size - 1
+    q::REGIONS.select { |start, _| start <= i }.last[1]
+  end
+
+  def self.scale(level)
+    return level if defined?(pbInDynAdventure?) && pbInDynAdventure?
+    curve = CURVE[region] or return level
+    a, b, lo, hi = curve
+    # Above the region's finale (rematches, legendaries) keep the same gap over the new finale.
+    n = level > b ? hi + level - b : lo + (level - a).clamp(0, b - a) * (hi - lo) / (b - a).to_f
+    n.round.clamp(level, GameData::GrowthRate.max_level)
+  rescue StandardError
+    level
+  end
+
+  def self.evolve(species, level)
+    pkmn = Pokemon.new(species, level)
+    start = pkmn.species
+    5.times { (evo = pkmn.check_evolution_on_level_up) ? pkmn.species = evo : break }
+    pkmn.species == start ? species : pkmn.species   # unevolved: keep the caller's id (form ids like :RATTATA_1)
+  rescue StandardError
+    species
+  end
+
+  def self.scale_trainer(trainer, data)
+    keep = (data ? data.pokemon : []).select { |p| p[:moves] && !p[:moves].empty? }
+                                     .map { |p| GameData::Species.get(p[:species]).species }
+    trainer.party.each do |pkmn|
+      level = scale(pkmn.level)
+      next if level == pkmn.level
+      pkmn.level = level
+      pkmn.reset_moves unless keep.include?(pkmn.species)
+      pkmn.calc_stats
+    end
+  rescue StandardError
+    nil
+  end
+end
+
+alias fire_ash_level_curve_wild pbGenerateWildPokemon
+def pbGenerateWildPokemon(species, level, isRoamer = false)
+  new_level = FireAshLevelCurve.scale(level)
+  species = FireAshLevelCurve.evolve(species, new_level) if new_level != level
+  fire_ash_level_curve_wild(species, new_level, isRoamer)
+end
+
+alias fire_ash_level_curve_trainer pbLoadTrainer
+def pbLoadTrainer(tr_type, tr_name, tr_version = 0)
+  trainer = fire_ash_level_curve_trainer(tr_type, tr_name, tr_version)
+  FireAshLevelCurve.scale_trainer(trainer, GameData::Trainer.try_get(tr_type, tr_name, tr_version)) if trainer
+  trainer
+end
