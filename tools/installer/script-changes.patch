+#===============================================================================
+# Wild legendaries: 2% of grass/cave/water/fishing/Headbutt encounters become a
+# legendary of the current story region's generation that the player has not
+# caught yet. Level is the rolled one, then FireAshLevelCurve applies. Story
+# events are untouched; Bug Contest and Poké Radar are excluded.
+#===============================================================================
+module FireAshWildLegendary
+  CHANCE = 2
+  GENERATION = { kanto: 1, orange: 1, johto: 2, hoenn: 3, frontier: 3, sinnoh: 4,
+                 unova: 5, kalos: 6, alola: 7, galar: 8 }
+  NOT_LEGENDARY = [:UNOWN, :DRACOZOLT, :ARCTOZOLT, :DRACOVISH, :ARCTOVISH]   # fossils share the egg group
+
+  def self.pool
+    gen = GENERATION[FireAshLevelCurve.region]
+    list = []
+    GameData::Species.each do |sp|
+      next if sp.form != 0 || sp.generation != gen || NOT_LEGENDARY.include?(sp.species)
+      next if sp.egg_groups != [:Undiscovered] || !sp.evolutions.empty?
+      list << sp.species unless $Trainer.owned?(sp.species)
+    end
+    list
+  end
+
+  def self.modify(encounter)
+    return encounter if !encounter || rand(100) >= CHANCE
+    return encounter if $PokemonTemp.pokeradar || (defined?(pbInBugContest?) && pbInBugContest?)
+    species = pool.sample
+    species ? [species, encounter[1]] : encounter
+  rescue StandardError
+    encounter
+  end
+end
+EncounterModifier.register(proc { |encounter| FireAshWildLegendary.modify(encounter) })
