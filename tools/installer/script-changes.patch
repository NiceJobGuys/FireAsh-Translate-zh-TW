+# encoding: UTF-8
+# Installed before Main. Also renders the Chinese label in an English menu.
+module FireAshZHTW
+  FONT = Font.exist?("Noto Sans CJK TC") ? "Noto Sans CJK TC" : "Noto Sans CJK TC Medium"
+  # This game's mkxp truncates Font.size * 0.90 before opening the font.
+  PIXEL_SIZES = [14, 27, 40, 54, 67, 80, 94].freeze
+  NO_LINE_START = "，。、！？：；％）］｝〉》」』】〕〗〙〛…・·‧—,.!?:;%)]}”’"
+  NO_LINE_END = "（［｛〈《「『【〔〖〘〚([{“‘"
+
+  def self.cjk_boundary?(previous, current)
+    return false unless previous && current
+    return false if previous.match?(/\s/) || current.match?(/\s/)
+    return false if NO_LINE_START.include?(current) || NO_LINE_END.include?(previous)
+    previous.match?(/[\u3400-\u9fff]/) || current.match?(/[\u3400-\u9fff]/)
+  end
+
+  def self.active?
+    return false unless defined?(Settings::LANGUAGES)
+    return false unless defined?($PokemonSystem) && $PokemonSystem
+    language = Settings::LANGUAGES[$PokemonSystem.language]
+    language && language[1] == "traditional_chinese.dat"
+  end
+
+  def self.size(value)
+    # Idempotent API sizes yield exactly 12, 24, ... 84 raster pixels.
+    return value if PIXEL_SIZES.include?(value)
+    # No script requests sizes below the grid; only shrink-to-fit loops reach them.
+    return value if value < PIXEL_SIZES[0]
+    scale = [[(value * 0.8 / 12.0).round, 1].max, PIXEL_SIZES.length].min
+    PIXEL_SIZES[scale - 1]
+  end
+
+  def self.row_text_offset(bitmap, height)
+    return 4 unless active?
+    [4, (height - bitmap.text_size("Ag").height) / 2].min
+  end
+
+  def self.ensure_loaded!
+    return unless active?
+    raise RuntimeError, "Noto font not loaded: Fonts/fire-ash-zhtw.otf. Restore the trial backup before continuing." unless Font.exist?(FONT)
+  end
+
+  def self.with_text_font(bitmap, text)
+    previous = nil
+    return yield unless text.is_a?(String)
+    sample = text.dup.force_encoding('UTF-8')
+    ensure_loaded!
+    font = bitmap.font
+    return yield unless font.name == FONT || (sample.valid_encoding? && sample.match?(/[\u3400-\u9fff]/))
+    previous = [font.name, font.size, font.bold, font.italic]
+    font.fire_ash_zhtw_name_set(FONT)
+    font.fire_ash_zhtw_size_set(size(font.size))
+    # Synthetic bold/italic introduce strokes off the pixel font's native grid.
+    font.bold = false
+    font.italic = false
+    yield
+  ensure
+    if previous
+      font.fire_ash_zhtw_name_set(previous[0])
+      font.fire_ash_zhtw_size_set(previous[1])
+      font.bold = previous[2]
+      font.italic = previous[3]
+    end
+  end
+end
+
+class Bitmap
+  alias_method :fire_ash_zhtw_draw_text, :draw_text
+  alias_method :fire_ash_zhtw_text_size, :text_size
+
+  def draw_text(*args)
+    text = args.find { |arg| arg.is_a?(String) }
+    FireAshZHTW.with_text_font(self, text) { fire_ash_zhtw_draw_text(*args) }
+  end
+
+  def text_size(*args)
+    FireAshZHTW.with_text_font(self, args[0]) { fire_ash_zhtw_text_size(*args) }
+  end
+end
+
+class Font
+  alias_method :fire_ash_zhtw_initialize, :initialize
+  alias_method :fire_ash_zhtw_name_set, :name=
+  alias_method :fire_ash_zhtw_size_set, :size=
+
+  def initialize(*args)
+    fire_ash_zhtw_initialize(*args)
+    if FireAshZHTW.active?
+      FireAshZHTW.ensure_loaded!
+      self.fire_ash_zhtw_name_set(FireAshZHTW::FONT)
+      self.fire_ash_zhtw_size_set(FireAshZHTW.size(size))
+    end
+  end
+
+  def name=(value)
+    self.fire_ash_zhtw_name_set(FireAshZHTW.active? ? FireAshZHTW::FONT : value)
+  end
+
+  def size=(value)
+    return self.fire_ash_zhtw_size_set(value) unless FireAshZHTW.active?
+    snapped = FireAshZHTW.size(value)
+    # Name shrink loops repeat `font.size -= 1` until the text fits; snapping would undo every
+    # step and freeze the game. A repeated request snapping cannot honour steps down instead.
+    if value < size && snapped >= size
+      snapped = FireAshZHTW::PIXEL_SIZES.reverse.find { |s| s < size } || value if @fire_ash_zhtw_stalled == value
+      @fire_ash_zhtw_stalled = value
+    else
+      @fire_ash_zhtw_stalled = nil
+    end
+    self.fire_ash_zhtw_size_set(snapped)
+  end
+end
+
+# Plain text windows use a different layout path from formatted dialogue.
+module FireAshZHTW
+  def self.plain_wrap_units(bitmap, words, width)
+    words.flat_map do |word|
+      units = []
+      current = ""
+      word.each_char do |char|
+        if cjk_boundary?(current[-1], char)
+          units.push(current)
+          current = ""
+        end
+        current += char
+      end
+      units.push(current) unless current.empty?
+      # Keep Latin words together unless a single word exceeds the whole box.
+      units.flat_map { |unit| bitmap.text_size(unit).width > width ? unit.each_char.to_a : [unit] }
+    end
+  end
+
+  def self.draw_ability_description(bitmap, x, y, width, height, text, base, shadow)
+    return drawTextEx(bitmap, x, y, width, 2, text, base, shadow) unless active?
+    original_size = bitmap.font.size
+    dims = []
+    chunks = getLineBrokenChunks(bitmap, text, width, dims, true)
+    if dims[1] > height
+      bitmap.font.size = 14
+      chunks = getLineBrokenChunks(bitmap, text, width, dims, true)
+      chunks.each do |chunk|
+        chunk[2] = chunk[2] / 32 * 20
+        chunk[4] = 20
+      end
+    end
+    renderLineBrokenChunksWithShadow(bitmap, x, y, chunks, height, base, shadow)
+  ensure
+    bitmap.font.size = original_size if original_size
+  end
+end

