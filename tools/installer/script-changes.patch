+#===============================================================================
+# Ability splash, Chinese mode: the ability line is drawn at y 32 (+6) in a 64px
+# bitmap, sized for Power Green; the Chinese font's taller line box ran past the
+# bottom and cut the characters off (user report 2026-11-03). Its box bottom now
+# sits 2px under the bitmap's bottom edge, which is only descender space.
+# Prepended: nothing later redefines AbilitySplashBar or aliases this method on it.
+#===============================================================================
+module FireAshAbilitySplash
+  def pbDrawTextPositions(bitmap, textpos)
+    if defined?(FireAshZHTW) && FireAshZHTW.active? && bitmap.equal?(self.bitmap) && textpos[1]
+      line = textpos[1]
+      line[2] = [line[2], bitmap.height - bitmap.text_size(line[0].to_s).height - 4].min
+    end
+    super
+  end
+end
+AbilitySplashBar.prepend(FireAshAbilitySplash)

