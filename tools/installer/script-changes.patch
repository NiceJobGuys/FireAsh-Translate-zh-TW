+  def self.done?(cond)
+    case cond
+    when Integer then $game_switches[cond] == true
+    when Array then cond.any? { |c| done?(c) }
+    else cond.call == true
+    end
+  rescue StandardError
+    false
+  end
+
+  def self.next_step
+    last = -1
+    STEPS.each_with_index { |s, i| last = i if s[3] && done?(s[0]) }
+    STEPS[(last + 1)..-1].find { |s| !done?(s[0]) }
+  end
+
+  def self.message
+    s = next_step
+    return "主線劇情已經全部完成！" if !s
+    "下一步：#{s[2]}\n地點：#{pbGetMapNameFromId(s[1])}"
+  end
+
+  # [region, x, y] on the Town Map for the next step; interiors without their
+  # own MapPosition use the nearest parent map that has one.
+  def self.town_map_point
+    s = next_step or return nil
+    id = s[1]
+    while id && id > 0
+      meta = GameData::MapMetadata.try_get(id)
+      return meta.town_map_position if meta && meta.town_map_position
+      info = pbLoadMapInfos[id]
+      id = info && info.parent_id
+    end
+    nil
+  rescue StandardError
+    nil
+  end
+end
