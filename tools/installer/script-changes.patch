+#===============================================================================
+# Type-effectiveness marker on each move button, using the game's own battle
+# calculation (dual types, Roost, Foresight, Freeze-Dry, ...). Prepended: ZUD
+# redefines refreshButtonNames later with a bare def and nothing aliases it.
+#===============================================================================
+module FireAshMoveHints
+  INK = { "o" => Color.new(48, 48, 48), "w" => Color.new(248, 248, 248), "r" => Color.new(232, 72, 72),
+          "b" => Color.new(96, 128, 240), "g" => Color.new(176, 176, 176) }
+  ICONS = {
+    :super  => ["....oooo....", "..oorrrroo..", ".orrrrrrrro.", ".orrrrrrrro.", "orrrrrrrrrro", "orrrrrrrrrro",
+                "orrrrrrrrrro", "orrrrrrrrrro", ".orrrrrrrro.", ".orrrrrrrro.", "..oorrrroo..", "....oooo...."],
+    :normal => ["....oooo....", "..oowwwwoo..", ".owwoooowwo.", ".owo....owo.", "owo......owo", "owo......owo",
+                "owo......owo", "owo......owo", ".owo....owo.", ".owwoooowwo.", "..oowwwwoo..", "....oooo...."],
+    :weak   => [".....oo.....", "....obbo....", "....obbo....", "...obbbbo...", "...obbbbo...", "..obbbbbbo..",
+                "..obbbbbbo..", ".obbbbbbbbo.", ".obbbbbbbbo.", "obbbbbbbbbbo", "oooooooooooo", "............"],
+    :immune => ["oo........oo", "oggo....oggo", ".oggo..oggo.", "..oggooggo..", "...oggggo...", "....oggo....",
+                "....oggo....", "...oggggo...", "..oggooggo..", ".oggo..oggo.", "oggo....oggo", "oo........oo"],
+    # Town Map marker for the main quest's next location (FireAshMainQuest).
+    :quest  => ["....oooo....", "..oorrrroo..", ".orrrwwrrro.", ".orrrwwrrro.", "orrrrwwrrrro", "orrrrwwrrrro",
+                "orrrrwwrrrro", "orrrrrrrrrro", ".orrrwwrrro.", ".orrrwwrrro.", "..oorrrroo..", "....oooo...."]
+  }.freeze
+  ICON_X, ICON_Y = 7, 17   # on the button's type-coloured left band, clear of the name
+
+  # :super, :normal, :weak, :immune, or nil (status move, mixed doubles result, unknown).
+  def self.mark(user, move)
+    return nil if !user || !move || move.statusMove?
+    foes = []
+    user.eachOpposing { |b| foes << b }
+    return nil if foes.empty?
+    boost = move.instance_variable_get(:@powerBoost)
+    type = move.pbCalcType(user)
+    move.instance_variable_set(:@powerBoost, boost)   # pbCalcType resets it; the real use recalculates
+    marks = foes.map do |foe|
+      v = move.pbCalcTypeMod(type, user, foe)
+      if Effectiveness.ineffective?(v) then :immune
+      elsif Effectiveness.super_effective?(v) then :super
+      elsif Effectiveness.not_very_effective?(v) then :weak
+      else :normal
+      end
+    end.uniq
+    marks.length == 1 ? marks[0] : nil
+  rescue StandardError
+    nil
+  end
+
+  def self.draw(bitmap, symbol, x, y)
+    ICONS.fetch(symbol).each_with_index do |row, dy|
+      row.each_char.with_index { |c, dx| bitmap.fill_rect(x + dx, y + dy, 1, 1, INK[c]) if INK[c] }
+    end
+  end
+
