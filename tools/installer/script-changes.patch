+class Spriteset_Map
+  alias fire_ash_hints_update update
+  def update
+    fire_ash_hints_update
+    return if @map != $game_map || @tilemap.disposed?
+    @fire_ash_sparkle = (@fire_ash_sparkle || 0) + 1
+    return if @fire_ash_sparkle < FireAshFieldHints::SPARKLE_INTERVAL
+    @fire_ash_sparkle = 0
+    @map.events.each_value do |event|
+      next unless event.fire_ash_hint == :sparkle
+      next unless event.screen_x.between?(-32, Graphics.width + 32) &&
+                  event.screen_y.between?(-32, Graphics.height + 64)
+      addUserAnimation(Settings::PLANT_SPARKLE_ANIMATION_ID, event.x, event.y, false, 1)
+    end
+  end
+end
