+class PokemonDataBox
+  alias fire_ash_stages_initializeOtherGraphics initializeOtherGraphics
+  def initializeOtherGraphics(viewport)
+    fire_ash_stages_initializeOtherGraphics(viewport)
+    side = (@battler.battle.pbSideSize(@battler.index) rescue 1)
+    @fire_ash_stages_offset = FireAshStatStages.offset(@databoxBitmap.height, @spriteBaseX, side)
+    return if !@fire_ash_stages_offset
+    @fire_ash_stages = BitmapSprite.new(FireAshStatStages::ORDER.length * (FireAshStatStages::CHIP_W + 1),
+                                        FireAshStatStages::CHIP_H, viewport)
+    @fire_ash_stages.z = self.z + 10   # above the next box down (+5) in doubles, below menus (180+)
+    @fire_ash_stages.visible = self.visible
+    @sprites["fire_ash_stages"] = @fire_ash_stages
+  end
+
+  alias fire_ash_stages_set_x x=
+  def x=(value)
+    fire_ash_stages_set_x(value)
+    @fire_ash_stages.x = value + @fire_ash_stages_offset[0] if @fire_ash_stages
+  end
+
+  alias fire_ash_stages_set_y y=
+  def y=(value)
+    fire_ash_stages_set_y(value)
+    @fire_ash_stages.y = value + @fire_ash_stages_offset[1] if @fire_ash_stages
+  end
+
+  alias fire_ash_stages_update update
+  def update(frameCounter = 0)
+    fire_ash_stages_update(frameCounter)
+    fire_ash_stages_refresh
+  end
+
+  def fire_ash_stages_refresh
+    return if !@fire_ash_stages || @fire_ash_stages.disposed?
+    # Safari's PokeBattle_FakeBattler has no stages
+    changes = (@battler && @battler.respond_to?(:stages) && @battler.pokemon) ? FireAshStatStages.changed(@battler) : []
+    return if changes == @fire_ash_stages_shown
+    @fire_ash_stages_shown = changes
+    FireAshStatStages.draw(@fire_ash_stages.bitmap, changes)
+  rescue StandardError
+    nil
+  end
+end
