+  def pbGoToPrevious
+    newindex = @partyindex
+    while newindex>0
+      newindex -= 1
+      if @party[newindex] && (@page==1 || !@party[newindex].egg?)
+        @partyindex = newindex
+        break
+      end
+    end
+  end
+
+  def pbGoToNext
+    newindex = @partyindex
+    while newindex<@party.length-1
+      newindex += 1
+      if @party[newindex] && (@page==1 || !@party[newindex].egg?)
+        @partyindex = newindex
+        break
+      end
+    end
+  end
