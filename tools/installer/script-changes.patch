+  def pbChangePokemon
+    @pokemon = @party[@partyindex]
+    @sprites["pokemon"].setPokemonBitmap(@pokemon)
+    @sprites["itemicon"].item = @pokemon.item_id
+    pbSEStop
+    @pokemon.play_cry
