+#===============================================================================
+# Stat stage chips under each battle databox's HP bar: one 19x11 chip per
+# changed stat (attack, defense, Sp. Atk, Sp. Def, speed, accuracy, evasion),
+# orange when raised, blue when lowered, with the stage count. Polled in
+# update because many effects write battler.stages without a databox refresh.
+# Alias-chained: ZUD later aliases initializeOtherGraphics/dispose and only
+# redefines refresh; the chip sprite sits in @sprites, so the box's own
+# visible=/opacity=/color=/flash/dispose already cover it.
+#===============================================================================
+module FireAshStatStages
+  ORDER = [:ATTACK, :DEFENSE, :SPECIAL_ATTACK, :SPECIAL_DEFENSE, :SPEED, :ACCURACY, :EVASION]
+  GLYPHS = {
+    :ATTACK          => ["....#....", ".#..#..#.", "..#.#.#..", "...###...", "#########",
+                         "...###...", "..#.#.#..", ".#..#..#.", "....#...."],   # burst
+    :DEFENSE         => ["#########", "##.###.##", "###.#.###", "####.####", "###.#.###",
+                         ".#.###.#.", ".#######.", "..#####..", "....#...."],   # shield, burst cut out
+    :SPECIAL_ATTACK  => ["..#####..", ".#.....#.", "#..###..#", "#.#...#.#", "#.#.#.#.#",
+                         "#.#...#.#", "#..###..#", ".#.....#.", "..#####.."],   # ripple
+    :SPECIAL_DEFENSE => ["#########", "###...###", "##.###.##", "##.###.##", "##.###.##",
+                         ".##...##.", ".#######.", "..#####..", "....#...."],   # shield, ring cut out
+    :SPEED           => [".........", "##..##...", ".##..##..", "..##..##.", "...##..##",
+                         "..##..##.", ".##..##..", "##..##...", "........."],   # double chevron
+    :ACCURACY        => ["##.....##", "#.......#", ".........", "....#....", "...###...",
+                         "....#....", ".........", "#.......#", "##.....##"],   # sight brackets
+    :EVASION         => [".......##", ".....####", "....###.#", "...###.#.", "..###.#..",
+                         ".###.#...", ".##.#....", ".#.......", "#........"]    # feather
+  }.freeze
+  DIGITS = {
+    "+" => ["...", ".#.", "###", ".#.", "..."], "-" => ["...", "...", "###", "...", "..."],
+    "1" => [".#.", "##.", ".#.", ".#.", "###"], "2" => ["##.", "..#", ".#.", "#..", "###"],
+    "3" => ["##.", "..#", ".#.", "..#", "##."], "4" => ["#.#", "#.#", "###", "..#", "..#"],
+    "5" => ["###", "#..", "##.", "..#", "##."], "6" => [".##", "#..", "###", "#.#", "###"]
+  }.freeze
+  BG    = Color.new(40, 40, 48)
+  UP    = Color.new(255, 160, 64)
+  DOWN  = Color.new(104, 168, 255)
+  WHITE = Color.new(248, 248, 248)
+  CHIP_W, CHIP_H = 19, 11
+
+  def self.changed(battler)
+    ORDER.map { |s| [s, battler.stages[s].to_i] }.reject { |_, v| v == 0 }
+  end
+
+  def self.draw(bitmap, changes)
+    bitmap.clear
+    changes.each_with_index do |(stat, v), i|
+      x = i * (CHIP_W + 1)
+      ink = v > 0 ? UP : DOWN
+      bitmap.fill_rect(x + 1, 0, CHIP_W - 2, CHIP_H, BG)   # rounded corners
+      bitmap.fill_rect(x, 1, CHIP_W, CHIP_H - 2, BG)
+      plot(bitmap, GLYPHS[stat], x + 1, 1, ink)
+      plot(bitmap, DIGITS[v > 0 ? "+" : "-"], x + 11, 3, ink)
+      plot(bitmap, DIGITS[[v.abs, 6].min.to_s], x + 15, 3, WHITE)
+    end
+  end
+
+  def self.plot(bitmap, rows, x, y, color)
+    rows.each_with_index do |row, dy|
+      row.each_char.with_index { |c, dx| bitmap.fill_rect(x + dx, y + dy, 1, 1, color) if c == "#" }
+    end
+  end
+
+  # Chip strip offset inside the databox, starting at the "HP" label. Player
+  # single box (84 tall, Exp bar last): just below it, above the menu at y 288.
+  # Thin/foe boxes (62): the empty band under the HP bar; in doubles the next
+  # box starts 54 lower and its rows 0..9 are frame only, names start at 10.
+  # Triples overlap 46 apart, so the strip moves up onto the bar's border.
+  # Max Raid box (74) and anything else: none.
+  def self.offset(box_height, base_x, side_size)
+    case box_height
+    when 84 then [base_x + 70, 84]
+    when 62 then [base_x + 70, side_size >= 3 ? 46 : 50]
+    end
+  end
+end
