{
  "policy": "僅修改文字顯示查詢；SygnaBuff.name、價格、等級、比較與存檔識別名稱維持原版。",
  "patches": [
    {
      "script": "Interpreter_Commands",
      "kind": "display-only",
      "before": "command = pbShowCommands(nil, @list[@index].parameters[0], @list[@index].parameters[1])",
      "after": "choices = @list[@index].parameters[0]\n    choices = choices.map { |choice| _MAPINTL($game_map.map_id, choice) } if FireAshZHTW.active?\n    command = pbShowCommands(nil, choices, @list[@index].parameters[1])"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "    else\r\n      if @letterbyletter\r\n        @fmtchars = []",
      "after": "    else\r\n      dialog_y_offset = FireAshZHTW.row_text_offset(self.contents, 32)\r\n      if @letterbyletter\r\n        @fmtchars = []"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "          ch[2] += 4\r\n          if !ch[5]",
      "after": "          ch[2] += ch[5] ? [dialog_y_offset, 0].max : dialog_y_offset\r\n          if !ch[5]"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "          ch[2] += 4\r\n          @textchars.push",
      "after": "          ch[2] += ch[5] ? [dialog_y_offset, 0].max : dialog_y_offset\r\n          @textchars.push"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "    self.height=dims[1] - 6",
      "after": "    self.height=dims[1] - (FireAshZHTW.active? ? 0 : 6)"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "         self.contents,rect.x,rect.y+4,rect.width,rect.height,",
      "after": "         self.contents,rect.x,rect.y,rect.width,rect.height,"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "         @commands[index],rect.height,true,true)\r\n      drawFormattedChars(self.contents,chars)",
      "after": "         @commands[index],rect.height,true,true)\r\n      offset = FireAshZHTW.row_text_offset(self.contents, rect.height)\r\n      chars.each { |ch| ch[2] += ch[5] ? [offset, 0].max : offset }\r\n      drawFormattedChars(self.contents,chars)"
    },
    {
      "script": "PokeBattle_SceneElements",
      "kind": "display-only",
      "before": "    # Draw Pokémon's name\r\n    nameWidth = self.bitmap.text_size(@battler.name).width\r\n    nameOffset = 0\r\n    nameOffset = nameWidth-116 if nameWidth>116\r\n    textPos.push([@battler.name,@spriteBaseX+8-nameOffset,0,false,NAME_BASE_COLOR,NAME_SHADOW_COLOR])\r\n    # Draw Pokémon's gender symbol\r\n    case @battler.displayGender\r\n    when 0   # Male\r\n      textPos.push([_INTL(\"♂\"),@spriteBaseX+126,0,false,MALE_BASE_COLOR,MALE_SHADOW_COLOR])\r\n    when 1   # Female\r\n      textPos.push([_INTL(\"♀\"),@spriteBaseX+126,0,false,FEMALE_BASE_COLOR,FEMALE_SHADOW_COLOR])\r\n    end\r\n    pbDrawTextPositions(self.bitmap,textPos)\r\n",
      "after": "    if FireAshZHTW.active?\n      FireAshZHTW.fit_ui_text(self.bitmap,@battler.name,@spriteBaseX+8,10,112,28,NAME_BASE_COLOR)\n      if @battler.displayGender == 0 || @battler.displayGender == 1\n        symbol = @battler.displayGender == 0 ? \"♂\" : \"♀\"\n        color = @battler.displayGender == 0 ? MALE_BASE_COLOR : FEMALE_BASE_COLOR\n        FireAshZHTW.fit_ui_text(self.bitmap,symbol,@spriteBaseX+126,12,14,20,color,0,14)\n      end\n    else\n    # Draw Pokémon's name\r\n    nameWidth = self.bitmap.text_size(@battler.name).width\r\n    nameOffset = 0\r\n    nameOffset = nameWidth-116 if nameWidth>116\r\n    textPos.push([@battler.name,@spriteBaseX+8-nameOffset,0,false,NAME_BASE_COLOR,NAME_SHADOW_COLOR])\r\n    # Draw Pokémon's gender symbol\r\n    case @battler.displayGender\r\n    when 0   # Male\r\n      textPos.push([_INTL(\"♂\"),@spriteBaseX+126,0,false,MALE_BASE_COLOR,MALE_SHADOW_COLOR])\r\n    when 1   # Female\r\n      textPos.push([_INTL(\"♀\"),@spriteBaseX+126,0,false,FEMALE_BASE_COLOR,FEMALE_SHADOW_COLOR])\r\n    end\r\n    pbDrawTextPositions(self.bitmap,textPos)\r\n    end\n"
    },
    {
      "script": "PokeBattle_SceneMenus",
      "kind": "display-only",
      "before": "    pbDrawTextPositions(@overlay.bitmap,textPos)",
      "after": "    if FireAshZHTW.active?\n      @buttons.each_with_index do |button,i|\n        next if !@visibility[\"button_#{i}\"] || !moves[i]\n        FireAshZHTW.fit_ui_text(@overlay.bitmap,moves[i].name,\n          button.x-self.x+14,button.y-self.y+8,button.src_rect.width-28,BUTTON_HEIGHT-16,TEXT_BASE_COLOR,1)\n      end\n    else\n      pbDrawTextPositions(@overlay.bitmap,textPos)\n    end"
    },
    {
      "script": "PokeBattle_SceneMenus",
      "kind": "display-only",
      "before": "      pbDrawTextPositions(@infoOverlay.bitmap,textPos)",
      "after": "      if FireAshZHTW.active?\n        FireAshZHTW.fit_ui_text(@infoOverlay.bitmap,\"PP\",404,46,26,32,PP_COLORS[ppFraction*2],1,14)\n        FireAshZHTW.fit_ui_text(@infoOverlay.bitmap,\"#{move.pp}/#{move.total_pp}\",\n          432,46,70,32,PP_COLORS[ppFraction*2],1)\n      else\n        pbDrawTextPositions(@infoOverlay.bitmap,textPos)\n      end"
    },
