{
  "policy": "僅修改文字顯示查詢；SygnaBuff.name、價格、等級、比較與存檔識別名稱維持原版。",
  "patches": [
    {
      "script": "Interpreter_Commands",
      "kind": "display-only",
      "before": "command = pbShowCommands(nil, @list[@index].parameters[0], @list[@index].parameters[1])",
      "after": "choices = @list[@index].parameters[0]\n    choices = choices.map { |choice| _MAPINTL($game_map.map_id, choice) } if FireAshZHTW.active?\n    command = pbShowCommands(nil, choices, @list[@index].parameters[1])"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "    else\r\n      if @letterbyletter\r\n        @fmtchars = []",
      "after": "    else\r\n      dialog_y_offset = FireAshZHTW.row_text_offset(self.contents, 32)\r\n      if @letterbyletter\r\n        @fmtchars = []"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "          ch[2] += 4\r\n          if !ch[5]",
      "after": "          ch[2] += ch[5] ? [dialog_y_offset, 0].max : dialog_y_offset\r\n          if !ch[5]"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "          ch[2] += 4\r\n          @textchars.push",
      "after": "          ch[2] += ch[5] ? [dialog_y_offset, 0].max : dialog_y_offset\r\n          @textchars.push"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "    self.height=dims[1] - 6",
      "after": "    self.height=dims[1] - (FireAshZHTW.active? ? 0 : 6)"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "         self.contents,rect.x,rect.y+4,rect.width,rect.height,",
      "after": "         self.contents,rect.x,rect.y,rect.width,rect.height,"
    },
    {
      "script": "SpriteWindow_text",
      "kind": "display-only",
      "before": "         @commands[index],rect.height,true,true)\r\n      drawFormattedChars(self.contents,chars)",
      "after": "         @commands[index],rect.height,true,true)\r\n      offset = FireAshZHTW.row_text_offset(self.contents, rect.height)\r\n      chars.each { |ch| ch[2] += ch[5] ? [offset, 0].max : offset }\r\n      drawFormattedChars(self.contents,chars)"
    },
